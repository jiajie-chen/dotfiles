# region User Configs
[user]
	name = JJ Chen
	email = 

# region URL User Overrides

# NOTE: if a repo has multiple remote matches, later entries take priority
[includeIf "hasconfig:remote.*.url:https://github.com/**"]
	path = ~/.gitconfig.d/github-com.gitconfig
[includeIf "hasconfig:remote.*.url:https://www.github.com/**"]
	path = ~/.gitconfig.d/github-com.gitconfig
[includeIf "hasconfig:remote.*.url:https://github.huit.harvard.edu/**"]
	path = ~/.gitconfig.d/github-huit-harvard-edu.gitconfig

# endregion URL User Overrides
# endregion User Configs

# region Git Credential Manager
[credential]
	# Using GCM to do the OAuth2 flow and get temp access tokens
	# Use in-memory (non-persistent) cache for creds
	# Re-authentication after 8 hours (28800 seconds)
	credentialStore = cache
	cacheOptions = --timeout 28800
	helper = 
	helper = /usr/local/share/gcm-core/git-credential-manager
[credential "https://dev.azure.com"]
	useHttpPath = true
# endregion Git Credential Manager

# region Git Town
# NOTE: disabled plugin for now
[git-town]
	offline = false
	main-branch = main
	push-new-branches = false
	sync-feature-strategy = rebase
	sync-before-ship = true
# endregion Git Town

# region Common
[core]
	editor = code -n --wait
[diff]
	tool = vscode
[difftool "vscode"]
	cmd = code --wait --diff $LOCAL $REMOTE
[merge]
	tool = vscode
[mergetool "vscode"]
	cmd = code --wait $MERGED
[alias]
	# Custom CLI graph view
	tree = log --graph --decorate --pretty=oneline --abbrev-commit
	# Git prune local branches of merged PRs
	# From: https://stackoverflow.com/a/47939403
	prune-delete = "!f() { git fetch --prune && git branch --delete $(git for-each-ref --format '%(if:equals=gone)%(upstream:track,nobracket)%(then)%(refname:short)%(end)' refs/heads/); }; f"

	# Git Town aliases
	# append = town append
	# diff-parent = town diff-parent
	# hack = town hack
	# kill = town kill
	# prepend = town prepend
	# propose = town propose
	# rename-branch = town rename-branch
	# repo = town repo
	# set-parent = town set-parent
	# ship = town ship
	# sync = town sync

	# Other useful aliases: https://github.com/GitAlias/gitalias
[init]
	defaultBranch = main
	templateDir = ~/.config/git-templates/build/
[push]
	autoSetupRemote = true
[submodule]
	recurse = true
[rebase]
	autoSquash = true
	# updateRefs = true
# endregion Common
[filter "lfs"]
	required = true
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
