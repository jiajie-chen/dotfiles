# shellcheck disable=all
# ################################################################ #
# THE FOLLOWING IS AN EXPLANATION OF THE GRAMMAR THAT SKHD PARSES. #
# FOR SIMPLE EXAMPLE MAPPINGS LOOK FURTHER DOWN THIS FILE..        #
# ################################################################ #

# A list of all built-in modifier and literal keywords can
# be found at https://github.com/koekeishiya/skhd/issues/1
#
# A hotkey is written according to the following rules:
#
#   hotkey       = <mode> '<' <action> | <action>
#
#   mode         = 'name of mode' | <mode> ',' <mode>
#
#   action       = <keysym> '[' <proc_map_lst> ']' | <keysym> '->' '[' <proc_map_lst> ']'
#                  <keysym> ':' <command>          | <keysym> '->' ':' <command>
#                  <keysym> ';' <mode>             | <keysym> '->' ';' <mode>
#
#   keysym       = <mod> '-' <key> | <key>
#
#   mod          = 'modifier keyword' | <mod> '+' <mod>
#
#   key          = <literal> | <keycode>
#
#   literal      = 'single letter or built-in keyword'
#
#   keycode      = 'apple keyboard kVK_<Key> values (0x3C)'
#
#   proc_map_lst = * <proc_map>
#
#   proc_map     = <string> ':' <command> | <string>     '~' |
#                  '*'      ':' <command> | '*'          '~'
#
#   string       = '"' 'sequence of characters' '"'
#
#   command      = command is executed through '$SHELL -c' and
#                  follows valid shell syntax. if the $SHELL environment
#                  variable is not set, it will default to '/bin/bash'.
#                  when bash is used, the ';' delimeter can be specified
#                  to chain commands.
#
#                  to allow a command to extend into multiple lines,
#                  append '\' at the end of the previous line.
#
#                  an EOL character signifies the end of the bind.
#
#   ->           = keypress is not consumed by skhd
#
#   *            = matches every application not specified in <proc_map_lst>
#
#   ~            = application is unbound and keypress is forwarded per usual, when specified in a <proc_map>
#
# A mode is declared according to the following rules:
#
#   mode_decl = '::' <name> '@' ':' <command> | '::' <name> ':' <command> |
#               '::' <name> '@'               | '::' <name>
#
#   name      = desired name for this mode,
#
#   @         = capture keypresses regardless of being bound to an action
#
#   command   = command is executed through '$SHELL -c' and
#               follows valid shell syntax. if the $SHELL environment
#               variable is not set, it will default to '/bin/bash'.
#               when bash is used, the ';' delimeter can be specified
#               to chain commands.
#
#               to allow a command to extend into multiple lines,
#               prepend '\' at the end of the previous line.
#
#               an EOL character signifies the end of the bind.

# TODO: pressing lalt + ralt toggles these keybinds
# TODO: hammerspoon port?

# macOS bindings:
# alt - space : show spotlight

# change focused window (using arrow keys)
lalt - left  : aerospace focus --boundaries all-monitors-outer-frame left
lalt - down  : aerospace focus --boundaries all-monitors-outer-frame down
lalt - up    : aerospace focus --boundaries all-monitors-outer-frame up
lalt - right : aerospace focus --boundaries all-monitors-outer-frame right
# move focused window
lalt + shift - left  : aerospace move left
lalt + shift - down  : aerospace move down
lalt + shift - up    : aerospace move up
lalt + shift - right : aerospace move right
# join/group focused window
lalt + ctrl - left  : aerospace join-with left
lalt + ctrl - down  : aerospace join-with down
lalt + ctrl - up    : aerospace join-with up
lalt + ctrl - right : aerospace join-with right
# change focused workspace
lalt - 1 : aerospace workspace --auto-back-and-forth 1
lalt - 2 : aerospace workspace --auto-back-and-forth 2
lalt - 3 : aerospace workspace --auto-back-and-forth 3
lalt - 4 : aerospace workspace --auto-back-and-forth 4
lalt - 5 : aerospace workspace --auto-back-and-forth 5
lalt - 6 : aerospace workspace --auto-back-and-forth 6
lalt - 7 : aerospace workspace --auto-back-and-forth 7
lalt - 8 : aerospace workspace --auto-back-and-forth 8
lalt - 9 : aerospace workspace --auto-back-and-forth 9
lalt - 0 : aerospace workspace --auto-back-and-forth 10
# move focused window to workspace
lalt + shift - 1 : aerospace move-node-to-workspace 1
lalt + shift - 2 : aerospace move-node-to-workspace 2
lalt + shift - 3 : aerospace move-node-to-workspace 3
lalt + shift - 4 : aerospace move-node-to-workspace 4
lalt + shift - 5 : aerospace move-node-to-workspace 5
lalt + shift - 6 : aerospace move-node-to-workspace 6
lalt + shift - 7 : aerospace move-node-to-workspace 7
lalt + shift - 8 : aerospace move-node-to-workspace 8
lalt + shift - 9 : aerospace move-node-to-workspace 9
lalt + shift - 0 : aerospace move-node-to-workspace 10
# move focused workspace to monitor
lalt + ctrl + shift - left  : aerospace move-workspace-to-monitor --wrap-around prev
lalt + ctrl + shift - right : aerospace move-workspace-to-monitor --wrap-around next

# resizing focused window (minus/equal keys)
lalt + shift - 0x1B : aerospace resize smart -50
lalt + shift - 0x18 : aerospace resize smart +50

# change layout of desktop
lalt         - e     : aerospace layout tiles horizontal vertical
lalt         - s     : aerospace layout v_accordion
lalt         - w     : aerospace layout h_accordion
lalt + shift - space : aerospace layout floating tiling
# toggle window fullscreen
lalt         - f : aerospace fullscreen
lalt + shift - f : aerospace macos-native-fullscreen

# open terminal
lalt - return : osascript -e 'tell application "iTerm2" to create window with default profile'
